# SkyOps Intelligence — NAS 배포 환경변수 템플릿
# ============================================================================
# 실제 사용 시 `.env.nas` 로 복사 후 값 채우기 (gitignore 됨)
#   cp .env.nas.example .env.nas
#
# docker-compose.nas.yml 이 자동으로 이 파일을 읽음:
#   docker compose -f docker-compose.nas.yml --env-file .env.nas up -d

# ── Cloudflare Tunnel (외부 HTTPS) ───────────────────────────────────
# 1. https://one.dash.cloudflare.com/ → Zero Trust → Networks → Tunnels
# 2. "Create tunnel" → 이름: skyops-nas → Docker 섹션의 token 복사
# 3. 아래에 붙여넣기 (eyJ... 긴 문자열)
CLOUDFLARE_TUNNEL_TOKEN=

# ── Grafana 관리자 비밀번호 (기본 'skyops' 덮어쓰기) ─────────────────
GRAFANA_ADMIN_PASSWORD=change-me-please

# ── Timezone ─────────────────────────────────────────────────────────
TZ=Asia/Seoul

# ── Optional: LLM fallback disable (GPU 노트북이 NAS 와 같은 LAN 에 있다면) ─
# 학습/벤치용 GPU 서버가 있을 때:
# VLLM_BASE_URL=http://<GPU-PC-IP>:8001/v1
# LLM_MODE=vllm

# ── Optional: FAA SWIM (실 NOTAM 수신 시) ────────────────────────────
# SWIM_USERNAME=
# SWIM_PASSWORD=
# SWIM_TRUSTSTORE_PATH=/app/data/secrets/swim_trust

# ── Optional: KAC 공공데이터 (ATFM 실연동) ───────────────────────────
# KAC_API_KEY=
# ATFM_MODE=kac
