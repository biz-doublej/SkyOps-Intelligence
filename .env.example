# =============================================================
# SkyOps Intelligence — 환경 변수 예시
# 이 파일을 복사해서 .env 로 저장 후, 실제 값을 입력하세요.
# cp .env.example .env
# =============================================================

# -------------------------------------------------------------
# OpenSky Network API
# https://opensky-network.org/index.php?option=com_users&view=registration
# 무료 계정 생성 후 아이디/비밀번호를 그대로 사용합니다 (별도 API 키 없음)
# -------------------------------------------------------------
OPENSKY_USERNAME=your_opensky_username
OPENSKY_PASSWORD=your_opensky_password

# 수집 대상 영역 (한반도 + 주변 기본값)
OPENSKY_LAT_MIN=33.0
OPENSKY_LAT_MAX=38.9
OPENSKY_LON_MIN=124.0
OPENSKY_LON_MAX=130.0

# 폴링 주기 (초) — 무료 계정: 최소 10초 권장
OPENSKY_POLL_INTERVAL_SEC=30

# -------------------------------------------------------------
# METAR 기상 API (기상청 API Hub — KMA)
# https://apihub.kma.go.kr/  → 항공기상 → METAR/SPECI 조회
# 회원가입 후 인증키 발급 필요
# -------------------------------------------------------------
KMA_AUTH_KEY=your_kma_auth_key
KMA_METAR_URL=https://apihub.kma.go.kr/api/typ02/openApi/AmmIwxxmService/getMetar
KMA_DECODED_URL=https://apihub.kma.go.kr/api/typ01/url/air_metar_dec.php
KMA_AIRTM_URL=https://apihub.kma.go.kr/api/typ01/url/kma_air_tm.php

# 수집 대상 공항 ICAO 코드 (쉼표 구분)
METAR_STATIONS=RKSI,RKSS,RKPC,RKPK,RKTN,RKTU,RKJJ,RKJB

# 폴링 주기 (초) — METAR는 매시각 갱신, 30분(1800초) 권장
METAR_POLL_INTERVAL_SEC=1800

# -------------------------------------------------------------
# Kafka
# -------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_FLIGHT_POSITION=flight-position
KAFKA_TOPIC_WEATHER_EVENT=weather-event
KAFKA_TOPIC_GATE_EVENT=gate-event
# P4+ (2026-04-15) · Canonical Event Model topics
KAFKA_TOPIC_ATFM_RESTRICTION=atfm-restriction
KAFKA_TOPIC_NOTAM=notam
KAFKA_TOPIC_ALERT_DECISION=alert-decision

# -------------------------------------------------------------
# FAA SWIM — NOTAM Integration (P5+ · 2026-04-15)
# https://swim.aim.faa.gov/  → Subscription Manager
# JMS over Solace PubSub+ broker
# -------------------------------------------------------------
# 모드: mock (default) | swim (real FAA SWIM JMS subscriber)
NOTAM_MODE=mock

SWIM_HOST=tcps://ems2.swim.faa.gov:55443
SWIM_VPN=AIM_FNS
SWIM_USERNAME=your_swim_username
SWIM_PASSWORD=your_swim_password
SWIM_QUEUE=your_swim_queue_name
SWIM_CONNECTION_FACTORY=your_swim_cf

# TLS 설정 (mTLS 사용 시)
SWIM_CLIENT_CERT_PATH=
SWIM_CLIENT_KEY_PATH=
SWIM_TRUSTSTORE_PATH=
SWIM_RECONNECT_RETRIES=5
SWIM_RECONNECT_INTERVAL_SEC=10

# -------------------------------------------------------------
# FAA SWIM — ATFM/SFDPS (P5+ · 선택)
# -------------------------------------------------------------
ATFM_MODE=mock
SFDPS_HOST=tcps://ems2.swim.faa.gov:55443
SFDPS_VPN=
SFDPS_QUEUE=

# -------------------------------------------------------------
# OpenTelemetry (P3 · 2026-04-14)
# -------------------------------------------------------------
OTEL_ENABLED=1
OTEL_SERVICE_NAME=skyops-api
OTEL_SERVICE_VERSION=2.1.0
OTEL_CONSOLE_EXPORTER=1
OTEL_OTLP_EXPORTER=0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
DEPLOY_ENV=dev

# -------------------------------------------------------------
# vLLM (LLM serving)
# -------------------------------------------------------------
VLLM_BASE_URL=http://localhost:8001/v1
LLM_MODEL_ID=aviation-llm

# -------------------------------------------------------------
# Redis
# -------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# -------------------------------------------------------------
# PostgreSQL (ERD 설계 완료 후 사용)
# -------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=skyops
POSTGRES_USER=skyops_user
POSTGRES_PASSWORD=your_postgres_password

# -------------------------------------------------------------
# GCP (Phase 3 론칭 시 사용)
# -------------------------------------------------------------
GCP_PROJECT_ID=your_gcp_project_id
GCP_REGION=asia-northeast3
GCP_SERVICE_ACCOUNT_KEY_PATH=./secrets/gcp-sa-key.json

# -------------------------------------------------------------
# LLM Fine-tuning (Week 8: QLoRA)
# -------------------------------------------------------------
# Hugging Face gated model access (Meta Llama 3.1)
HF_TOKEN=your_huggingface_token

# Weights & Biases experiment tracking
WANDB_API_KEY=your_wandb_api_key
WANDB_PROJECT=skyops-qlora
WANDB_ENTITY=
